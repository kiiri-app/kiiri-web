# Inner static server for kiiri.app. The shared edge Caddy (scormedit stack) terminates
# TLS and proxies here; this one only serves files, mirrors site/_headers + _redirects.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	header /assets/* Cache-Control "public, max-age=604800"
	header /brand/* {
		Cache-Control "public, max-age=604800"
		Access-Control-Allow-Origin *
	}

	redir /download https://github.com/kiiri-app/kiiri/releases/latest 302
	redir /github https://github.com/kiiri-app/kiiri 302

	handle /api/* {
		reverse_proxy waitlist:8080
	}

	handle {
		# Clean URLs like Cloudflare Pages: /terms → terms.html, /terms.html → /terms
		@html path_regexp html ^(.+)\.html$
		redir @html {re.html.1} 308
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
